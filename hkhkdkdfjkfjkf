document.addEventListener('DOMContentLoaded', async function () {
  if (typeof requireAuthPage === 'function') requireAuthPage();

  var currentUser = null;
  try {
    var res = await api.get('/deposits');
    if (res.data && res.data.success) {
      currentUser = res.data.user;
      var bal = Number(currentUser.balance || 0).toFixed(2);
      var cur = currentUser.currency || 'USD $';
      var email = currentUser.email || '';

      var se = document.getElementById('sidebar-email');
      if (se) se.innerHTML = '<i class="fa fa-envelope-o"></i> ' + email;
      var sb = document.getElementById('sidebar-balance');
      if (sb) sb.innerHTML = '<b><i class="fa fa-money"></i> ' + bal + '</b> <b>' + cur + '</b>';

      document.getElementById('display-balance').textContent = bal;
      document.getElementById('display-balance-2').textContent = bal;
      document.getElementById('display-currency').textContent = cur;
      document.getElementById('display-currency-2').textContent = cur;
      document.getElementById('form-currency').textContent = cur;

      var html = kycHtml(currentUser.kycVerified);
      var sk = document.getElementById('sidebar-kyc'); if (sk) sk.innerHTML = html;
      var tk = document.getElementById('top-kyc'); if (tk) tk.innerHTML = html;
    }
  } catch (err) {
    console.error(err);
    if (err.response && err.response.status === 401) window.location.href = 'login.html';
  }

  document.getElementById('fundingForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!currentUser || !currentUser._id) {
      Swal.fire('Error', 'Please login again', 'error');
      return;
    }
    var amount = document.getElementById('amount').value.trim();
    var method = document.getElementById('payment_method').value;
    if (!amount || Number(amount) <= 0) {
      Swal.fire('Error', 'Enter a valid amount', 'error');
      return;
    }
    if (!method) {
      Swal.fire('Error', 'Select a deposit type', 'error');
      return;
    }

    var btn = document.getElementById('fundBtn');
    btn.disabled = true;
    btn.textContent = 'Processing...';

    try {
      var r = await api.post('/deposit/' + currentUser._id, {
        amount: amount,
        payment_method: method,
        method: method
      });
      if (r.data && r.data.success) {
        window.location.href = r.data.redirect || ('payment.html?id=' + currentUser._id);
      } else {
        Swal.fire('Error', (r.data && r.data.message) || 'Failed', 'error');
        btn.disabled = false;
        btn.textContent = 'Fund account';
      }
    } catch (err) {
      Swal.fire('Error', (err.response && err.response.data && err.response.data.message) || err.message || 'Failed', 'error');
      btn.disabled = false;
      btn.textContent = 'Fund account';
    }
  });
});
