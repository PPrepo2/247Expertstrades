<script>
(function () {
  var sidebar = document.getElementById('mainSidebar');
  var overlay = document.getElementById('sidebarOverlay');
  var toggleBtn = document.getElementById('menuToggleBtn');
  function openS() {
    if (sidebar) sidebar.classList.add('visible');
    if (overlay) overlay.classList.add('active');
  }
  function closeS() {
    if (sidebar) sidebar.classList.remove('visible');
    if (overlay) overlay.classList.remove('active');
  }
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function (e) {
      e.preventDefault();
      if (sidebar && sidebar.classList.contains('visible')) closeS();
      else openS();
    });
  }
  if (overlay) overlay.addEventListener('click', closeS);
  if (sidebar) {
    sidebar.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeS);
    });
  }
})();

document.addEventListener('DOMContentLoaded', async function () {
  if (typeof requireAuthPage === 'function') requireAuthPage();

  var currentUser = null;

  function kycHtml(status) {
    var s = status ? String(status).toLowerCase().trim() : '';
    if (s === 'approve' || s === 'approved') {
      return 'Kyc Verification: <span class="blinkgreen"><i class="fa fa-check-circle"></i> Verified</span>';
    }
    if (s === 'pending') {
      return 'Kyc Verification: <span style="color:#ff0"><i class="fa fa-clock-o"></i> Pending</span>';
    }
    return 'Kyc Verification: <span class="blinkred"><i class="fa fa-check-circle"></i> Required</span>';
  }

  function checkMatch() {
    var p = document.getElementById('pass').value;
    var r = document.getElementById('rpass').value;
    var el = document.getElementById('passcheck');
    if (!r) {
      el.textContent = '';
      return;
    }
    if (p === r) {
      el.style.color = '#0f0';
      el.textContent = 'Passwords match';
    } else {
      el.style.color = '#f66';
      el.textContent = 'Passwords do not match';
    }
  }

  document.getElementById('pass').addEventListener('input', checkMatch);
  document.getElementById('rpass').addEventListener('input', checkMatch);

  try {
    var res = await api.get('/security');
    if (!res.data || !res.data.success) {
      throw new Error((res.data && res.data.message) || 'Failed to load');
    }
    currentUser = res.data.user;

    var bal = Number(currentUser.balance || 0).toFixed(2);
    var cur = currentUser.currency || 'USD $';
    var email = currentUser.email || '';

    document.getElementById('sidebar-email').innerHTML =
      '<i class="fa fa-envelope-o"></i> ' + email;
    document.getElementById('sidebar-balance').innerHTML =
      '<b><i class="fa fa-money"></i> ' + bal + '</b> ' + cur;
    document.getElementById('sidebar-kyc').innerHTML = kycHtml(currentUser.kycVerified);
    document.getElementById('top-kyc').innerHTML = kycHtml(currentUser.kycVerified);
    document.getElementById('display-email').textContent = email;
    document.getElementById('display-balance').textContent = bal + ' ' + cur;
  } catch (err) {
    console.error(err);
    if (err.response && err.response.status === 401) {
      window.location.href = 'login.html';
      return;
    }
    Swal.fire('Error', 'Failed to load security settings', 'error');
  }

  document.getElementById('passwordForm').addEventListener('submit', async function (e) {
    e.preventDefault();

    if (!currentUser || !currentUser._id) {
      Swal.fire('Error', 'User not loaded. Please refresh the page.', 'error');
      return;
    }

    var current = document.getElementById('current').value;
    var pass = document.getElementById('pass').value;
    var rpass = document.getElementById('rpass').value;

    if (!current || !pass || !rpass) {
      Swal.fire('Error', 'All password fields are required', 'error');
      return;
    }
    if (pass.length < 8) {
      Swal.fire('Error', 'New password must be at least 8 characters long', 'error');
      return;
    }
    if (pass !== rpass) {
      Swal.fire('Error', 'New password and confirmation do not match', 'error');
      return;
    }

    var btn = document.getElementById('pass_btn');
    btn.disabled = true;
    btn.textContent = 'Saving...';

    try {
      var r = await api.post('/security/' + currentUser._id, {
        current_password: current,
        password: pass,
        password_confirmation: rpass,
        current: current,
        pass: pass,
        rpass: rpass
      });

      if (r.data && r.data.success) {
        await Swal.fire('Success', r.data.message || 'Password changed successfully', 'success');
        if (typeof logout === 'function') {
          logout();
        } else {
          localStorage.removeItem('token');
          localStorage.removeItem('user');
          window.location.href = 'login.html';
        }
      } else {
        Swal.fire('Error', (r.data && r.data.message) || 'Failed to change password', 'error');
      }
    } catch (err) {
      var msg =
        (err.response && err.response.data && err.response.data.message) ||
        err.message ||
        'Failed to change password';
      Swal.fire('Error', msg, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Save';
    }
  });
});
</script>

