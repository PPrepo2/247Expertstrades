document.addEventListener('DOMContentLoaded', async function(){
  if(typeof requireAuthPage==='function') requireAuthPage();

  var selectedType=null;
  var userBalance=0;
  var currentUser=null;

  function kycHtml(s){
    if(s==='approve') return 'Kyc Verification: <span class="blinkgreen"><i class="fa fa-check-circle"></i> Verified</span>';
    if(s==='pending') return 'Kyc Verification: <span style="color:#ff0"><i class="fa fa-clock-o"></i> Pending</span>';
    return 'Kyc Verification: <span class="blinkred"><i class="fa fa-check-circle"></i> Required</span>';
  }

  try{
    var res=await api.get('/withdraw');
    if(res.data&&res.data.success){
      currentUser=res.data.user;
      userBalance=Number(currentUser.balance||0);
      var bal=userBalance.toFixed(2);
      var cur=currentUser.currency||'USD $';
      document.getElementById('sidebar-email').innerHTML='<i class="fa fa-envelope-o"></i> '+(currentUser.email||'');
      document.getElementById('sidebar-balance').innerHTML='<b><i class="fa fa-money"></i> '+bal+'</b> <b>'+cur+'</b>';
      document.getElementById('sidebar-kyc').innerHTML=kycHtml(currentUser.kycVerified);
      document.getElementById('top-kyc').innerHTML=kycHtml(currentUser.kycVerified);
      document.getElementById('display-balance').textContent=bal;
      document.getElementById('display-currency').textContent=cur;
    }
  }catch(e){
    if(e.response&&e.response.status===401) window.location.href='login.html';
  }

  document.querySelectorAll('.method-card').forEach(function(card){
    card.addEventListener('click',function(){
      document.querySelectorAll('.method-card').forEach(function(c){c.classList.remove('selected')});
      card.classList.add('selected');
      selectedType=card.getAttribute('data-type');
    });
  });

  document.getElementById('nextBtn').addEventListener('click', async function(){
    var amount=Number(document.getElementById('withdrawAmount').value);
    if(!amount||amount<=0){
      Swal.fire('Error','Enter a valid amount','error');
      return;
    }
    if(!selectedType){
      Swal.fire('Error','Select a withdrawal method','error');
      return;
    }
    if(amount>userBalance){
      Swal.fire('Error','Insufficient balance for withdrawal','error');
      return;
    }

    try{
      if(currentUser&&currentUser._id){
        await api.post('/withdraw/init/'+currentUser._id,{amount:amount,type:selectedType});
      }
    }catch(err){
      var msg=(err.response&&err.response.data&&err.response.data.message)||'Insufficient balance';
      Swal.fire('Error',msg,'error');
      return;
    }

    localStorage.setItem('withdraw_amount', String(amount));
    localStorage.setItem('withdraw_type', selectedType);
    localStorage.setItem('withdraw_fees', '0.00');

    await Swal.fire({
      icon:'success',
      title:'Withdrawal initiated',
      text:'Proceed to enter payment details',
      confirmButtonText:'Continue'
    });
    window.location.href='withdraw-details.html';
  });
});
