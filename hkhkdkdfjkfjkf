  }
  return 'Kyc Verification: <span class="blinkred"><i class="fa fa-check-circle"></i> Required</span>';
}

function resolveMethodDetails(method, wallet) {
  var m = String(method || '').toUpperCase().trim();
  wallet = wallet || {};
  if (m === 'BANK DEPOSIT' || m === 'BANK' || m === 'BANK TRANSFER') {
    return { kind: 'bank' };
  }
  if (m === 'BITCOIN' || m === 'BTC') {
    return { kind: 'crypto', label: 'Official Bitcoin Wallet', address: wallet.btc_address || '', image: wallet.btc_image || '' };
  }
  if (m === 'ETHEREUM' || m === 'ETH') {
    return { kind: 'crypto', label: 'Official Ethereum Wallet', address: wallet.eth_address || '', image: wallet.eth_image || '' };
  }
  if (m === 'USDT') {
    return { kind: 'crypto', label: 'Official USDT Wallet', address: wallet.usdt_address || '', image: wallet.usdt_image || '' };
  }
  if (m === 'CASHAPP' || m === 'CASH APP') {
    return { kind: 'crypto', label: 'Official CashApp Tag', address: wallet.cashapp || '', image: wallet.cashapp_image || '' };
  }
  if (m === 'PAYPAL') {
    return { kind: 'crypto', label: 'Official PayPal Email', address: wallet.paypal || '', image: wallet.paypal_image || '' };
