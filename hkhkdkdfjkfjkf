      }),
      cloudinary.uploader.upload(backFile.path, {
        ...uploadOpts,
        public_id: `kyc_back_${userId}_${Date.now()}`
      }),
      cloudinary.uploader.upload(photoFile.path, {
        ...uploadOpts,
        public_id: `kyc_photo_${userId}_${Date.now()}`
      })
