document.addEventListener('DOMContentLoaded', async function () {
  if (typeof requireAuthPage === 'function') requireAuthPage();

  var params = new URLSearchParams(window.location.search);
  var idFromUrl = params.get('id');
  var paymentData = null;
  var userId = null;

  try {
    var url = idFromUrl ? ('/payment/' + idFromUrl) : '/payment';
    var res = await api.get(url);
    if (!res.data || !res.data.success) {
      Swal.fire('Error', (res.data && res.data.message) || 'No pending deposit', 'error').then(function () {
        window.location.href = (res.data && res.data.redirect) || 'funding.html';
      });
      return;
    }
    paymentData = res.data;
    userId = paymentData.user._id;

    var u = paymentData.user;
    var bal = Number(u.balance || 0).toFixed(2);
    var cur = u.currency || 'USD $';
    document.getElementById('sidebar-email').innerHTML = '<i class="fa fa-envelope-o"></i> ' + (u.email || '');
    document.getElementById('sidebar-balance').innerHTML = '<b><i class="fa fa-money"></i> ' + bal + '</b> <b>' + cur + '</b>';
    document.getElementById('display-balance').textContent = bal;
    document.getElementById('display-balance-2').textContent = bal;
    document.getElementById('display-currency').textContent = cur;

    var kycHtml = u.kycVerified
      ? 'Kyc Verification: <span class="blinkgreen"><i class="fa fa-check-circle"></i> Verified</span>'
      : 'Kyc Verification: <span class="blinkred"><i class="fa fa-check-circle"></i> Required</span>';
    document.getElementById('sidebar-kyc').innerHTML = kycHtml;
    document.getElementById('top-kyc').innerHTML = kycHtml;

    var method = String(paymentData.payment_method || '').toUpperCase();
    var amount = paymentData.amount;
    var wallet = paymentData.wallet || {};

    document.getElementById('pay-title').textContent = 'Deposit using ' + method;
    document.getElementById('pay-amount').textContent = amount;
    document.getElementById('pay-currency').textContent = cur;
    document.getElementById('hidden-amount').value = amount;
    document.getElementById('hidden-method').value = method;

    document.getElementById('block-crypto').classList.remove('active');
    document.getElementById('block-bank').classList.remove('active');

    if (method === 'BANK DEPOSIT') {
      document.getElementById('block-bank').classList.add('active');
      document.getElementById('bank_name').value = wallet.bank_name || '';
      document.getElementById('account_name').value = wallet.account_name || '';
      document.getElementById('account_no').value = wallet.account_no || '';
      document.getElementById('sortcode').value = wallet.sortcode || '';
      document.getElementById('swift_code').value = wallet.swift_code || '';
    } else {
      // BITCOIN, ETHEREUM, USDT, LUNO → use btc_wallet_address from Wallet schema
      document.getElementById('block-crypto').classList.add('active');
      document.getElementById('crypto-label').textContent = 'Official ' + method + ' Wallet';
      document.getElementById('mywallet').value = wallet.btc_wallet_address || '';
      if (wallet.btc_qr_image) {
        document.getElementById('qr-wrap').style.display = 'block';
        document.getElementById('coin_payment_image').src = wallet.btc_qr_image;
      } else if (wallet.btc_wallet_address) {
        document.getElementById('qr-wrap').style.display = 'block';
        document.getElementById('coin_payment_image').src =
          'https://chart.googleapis.com/chart?chs=200x200&cht=qr&chl=' + encodeURIComponent(wallet.btc_wallet_address);
      }
    }
  } catch (err) {
    console.error(err);
    var msg = (err.response && err.response.data && err.response.data.message) || 'Failed to load payment page';
    var redir = (err.response && err.response.data && err.response.data.redirect) || 'funding.html';
    Swal.fire('Error', msg, 'error').then(function () { window.location.href = redir; });
    return;
  }

  document.getElementById('confirmForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    if (!userId) return;

    var fileInput = document.getElementById('proof');
    if (!fileInput.files || !fileInput.files[0]) {
      Swal.fire('Error', 'Please upload proof of payment', 'error');
      return;
    }

    var fd = new FormData();
    fd.append('amount', document.getElementById('hidden-amount').value);
    fd.append('payment_method', document.getElementById('hidden-method').value);
    fd.append('image', fileInput.files[0]);

    var btn = document.getElementById('paidBtn');
    btn.disabled = true;
    btn.textContent = 'Submitting...';

    try {
      var r = await api.post('/deposit/confirm/' + userId, fd, {
        headers: { 'Content-Type': 'multipart/form-data' }
      });
      if (r.data && r.data.success) {
        await Swal.fire('Success', r.data.message, 'success');
        window.location.href = r.data.redirect || 'funding.html';
      } else {
        Swal.fire('Error', (r.data && r.data.message) || 'Failed', 'error');
        btn.disabled = false;
        btn.textContent = 'I have paid';
      }
    } catch (err) {
      Swal.fire('Error', (err.response && err.response.data && err.response.data.message) || err.message || 'Failed', 'error');
      btn.disabled = false;
      btn.textContent = 'I have paid';
    }
  });
});
</script>

